# Secrets — release.sh runs `git add .`, so this must stay first and correct.
.env
.env.*
!.env.example

# Runtime logs. The service writes to stdout and Docker captures it; a *.log in
# the tree only ever comes from running server.py by hand with a redirect.
*.log

# Transfer artefacts — the proxy source arrived as a zip. Nothing here is built
# from an archive, and release.sh runs `git add .`.
*.zip

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS / editors
.DS_Store
.vscode/
.idea/

# Claude Code local state
.claude/
