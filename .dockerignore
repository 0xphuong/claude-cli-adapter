# Keep the build context to exactly what the image needs: requirements.txt plus
# the server — claude_proxy/server.py for Dockerfile, server.py for Dockerfile.v1.
#
# Patterns here are matched against the WHOLE relative path and `*` does not
# cross a `/`, so a bare `*.md` only ever hides top-level files. Anything meant
# to apply inside claude_proxy/ needs the `**/` form.

.git
.gitignore
.github

# Secrets — must never enter the build context
.env
.env.*
!.env.example
*.pem
*.key

# Docker's own files
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml

# Docker's own files (v1 keeps the pre-proxy adapter build)
Dockerfile.v1

# Docs
README.md
*.md
**/*.md
LICENSE

# Runtime logs — the service logs to stdout; a *.log here is a local artefact
*.log
**/*.log

# Tests run against the container from outside; they do not belong in the image
smoke-test.sh
smoke-test.py

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Claude Code local state
.claude/
**/.claude/
CLAUDE.md
