# Copy to .env and fill in.  .env is git-ignored and excluded from the build context.

# OPTIONAL — keep this line COMMENTED OUT for the normal setup. Log in inside
# the container instead, which works on any host:
#
#     docker compose up -d
#     docker compose exec adapter claude auth login
#
# Do not leave it as a bare `CLAUDE_CODE_OAUTH_TOKEN=`: docker-compose injects
# that as an empty string, which Claude Code reads as "use token auth" and which
# then shadows the login stored in the container. Comment it out or delete it.
#
# Uncomment only for CI or a host where the interactive flow is awkward; generate
# the value on the HOST with `claude setup-token` (needs an active subscription).
# CLAUDE_CODE_OAUTH_TOKEN=

# Host port to publish the adapter on (container always listens on 8082).
ADAPTER_PORT=8082

# Claude Code CLI version baked into the image at build time.
CLAUDE_CODE_VERSION=2.1.229

# Note: the default model is hardcoded in server.py (claude-opus-4-7) and is not
# configurable by environment variable. Clients should send "model" in the request.
