# Copy to .env and fill in.  .env is git-ignored and excluded from the build context.
#
# Pick ONE of the two auth modes below. Leave every line of the other one
# COMMENTED OUT — not blank. docker-compose injects a bare `VAR=` as an empty
# string, and Claude Code reads an empty credential as "use this method", which
# then shadows the one you meant to use. The entrypoint normalises empties back
# to unset for the server, but `docker compose exec` bypasses it.

# ---------------------------------------------------------------------------
# Mode 1 — subscription (default)
# ---------------------------------------------------------------------------
# Nothing to set. Log in once and the credentials persist in the volume:
#
#     docker compose up -d
#     docker compose run --rm adapter claude auth login
#
# For CI, or a host where that interactive flow is awkward, generate a
# long-lived token on the HOST with `claude setup-token` and set it here:
# CLAUDE_CODE_OAUTH_TOKEN=

# ---------------------------------------------------------------------------
# Mode 2 — token against an Anthropic-compatible endpoint
# ---------------------------------------------------------------------------
# Routes the CLI at another endpoint entirely, so no subscription login is
# needed. Set both, or neither.
# ANTHROPIC_BASE_URL=http://your-gateway:port
# ANTHROPIC_AUTH_TOKEN=

# Use ANTHROPIC_API_KEY *instead of* ANTHROPIC_AUTH_TOKEN for an endpoint that
# expects an x-api-key header. Setting both makes Claude Code send two auth
# headers, which endpoints reject — the entrypoint refuses to start in that case.
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Common
# ---------------------------------------------------------------------------
# Model used when a client sends no "model" field. Must be a name the configured
# backend knows: a gateway usually namespaces them (e.g. cc/claude-sonnet-5),
# where the plain Anthropic default would 404.
# ADAPTER_DEFAULT_MODEL=claude-opus-4-7

# Host port to publish the adapter on (container always listens on 8082).
ADAPTER_PORT=8082

# Claude Code CLI version baked into the image at build time.
CLAUDE_CODE_VERSION=2.1.229

# Which published image tag to run. Only consulted when an image is pulled or
# already present locally — `docker compose up` builds from source when the tag
# is missing, so a dev machine ignores this. Pin a version on anything you care
# about; :latest moves under you.
# ADAPTER_IMAGE_TAG=v0.3.0
